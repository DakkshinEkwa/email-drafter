# Copy to .env and fill in. Prefixes match account.active in the org config
# (yahoo for vet, rackspace for oba).

YAHOO_EMAIL_ADDRESS=
YAHOO_EMAIL_PASSWORD=

RACKSPACE_EMAIL_ADDRESS=
RACKSPACE_EMAIL_PASSWORD=

OPENAI_API_KEY=

# Yahoo OAuth2 (optional; unused if app-password auth is set)
OAUTH_APP_ID=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# OAUTH_REFRESH_TOKEN=  # written automatically by --setup-oauth
